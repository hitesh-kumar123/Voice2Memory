# ==============================================================================
# Voice2Memory Environment Configuration
# ==============================================================================

# MongoDB / MongoDB Atlas Connection String
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/voice2memory?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/voice2memory
MONGODB_URI=mongodb://127.0.0.1:27017/voice2memory

# Open-Weight AI Brain (Google Gemma 2 via Ollama or remote endpoint)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b

# Optional: Remote OpenAI-compatible Gemma Endpoint (e.g. DigitalOcean GPU Droplet / vLLM)
# GEMMA_API_BASE=http://your-do-droplet-ip:11434/v1
# GEMMA_API_KEY=

# Optional: ElevenLabs Text-to-Speech API (for summary audio briefings)
# If left blank, Voice2Memory uses the browser's built-in Web Speech API
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: Custom Python path for faster-whisper (defaults to "python")
# PYTHON_PATH=python
